{
  "name": "otsuri",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:web": "expo export --platform web && node scripts/build-pwa.mjs",
    "test:pwa": "node --test tests/pwa.test.mjs",
    "deploy": "npm run build:web && wrangler pages deploy dist --project-name otsuri --branch main"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "expo": "~55.0.31",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2",
    "wrangler": "^4.147.0"
  }
}
